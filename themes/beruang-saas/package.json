{
  "name": "beruang-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Bare-bone SaaS theme for Beruang Budget.",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@10up/babel-preset-default": "^2.1.2",
    "10up-toolkit": "^6.5.1",
    "ajv": "^8.12.0",
    "eslint": "^8.57.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "scripts": {
    "start": "npm run watch",
    "watch": "10up-toolkit watch",
    "build": "npm run lint && 10up-toolkit build",
    "format-js": "10up-toolkit format-js",
    "lint": "npm run lint-js && npm run lint-css",
    "lint-js": "eslint \"assets/js/*.js\"",
    "lint-css": "stylelint \"assets/css/**/*.css\"",
    "lint-fix": "npm run lint-fix-js && npm run lint-fix-css",
    "lint-fix-js": "eslint --fix \"assets/js/*.js\"",
    "lint-fix-css": "stylelint --fix \"assets/css/**/*.css\"",
    "clean-dist": "rm -rf ./dist"
  },
  "10up-toolkit": {
    "entry": {
      "theme-script": "./assets/js/theme-script.js",
      "theme-style": "./assets/css/theme-style.css"
    }
  }
}
